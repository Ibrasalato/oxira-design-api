<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Oxira.Design.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <!-- orders and deliveries carry plan files (up to ~25 MB with the form); WebSockets for SignalR -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="27262976" />
        </requestFiltering>
      </security>
      <webSocket enabled="true" />
      <!-- keep the API's JSON error bodies (reason codes) instead of IIS error pages -->
      <httpErrors existingResponse="PassThrough" />
    </system.webServer>
  </location>
</configuration>
